  <link name="lidar_link">

    <visual>
      <origin xyz="-0.07142 -0.06488 -0.09997" rpy="1.57075 0.0 0.0"/>
      <geometry>
        <mesh filename="package://sumo/meshes/lidar.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1"/>
      </material>
    </visual>

    <collision>
