    </visual>
    <collision>
      <origin xyz="-0.03439 -0.03879 -0.05462" rpy="0 0 3.14159"/>
      <geometry>
        <mesh filename="package://sumo/meshes/motor-wheel.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel_link"/>
    <origin xyz="0.125 -0.13775 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <link name="front_left_wheel_link">
