<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sumo">
  <link name="base_link">

    <visual>
      <origin xyz="-0.17462 -0.18668 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://sumo/meshes/main-frame.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gray">
        <color rgba="0.6 0.6 0.6 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="-0.17462 -0.18668 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://sumo/meshes/main-frame.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

   <inertial>
    <origin xyz="-0.00117 0.00013 0.05125"/>
    <mass value="8.20158"/>
    <inertia ixx="0.0902089" ixy="0.0000740" ixz="0.0071159" iyy="0.0993226" iyz="0.0000221" izz="0.1666919"/>
  </inertial>

  </link>

  <link name="rear_left_wheel_link">
    <visual>
      <origin xyz="-0.03439 -0.03879 -0.05462" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://sumo/meshes/motor-wheel.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.03439 -0.03879 -0.05462" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://sumo/meshes/motor-wheel.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel_link"/>
    <origin xyz="0.125 0.13775 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <link name="rear_right_wheel_link">
    <visual>
      <origin xyz="-0.03439 -0.03879 -0.05462" rpy="0 0 3.14159"/>
